<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="fera_ai" translate="label" sortOrder="100">
            <label>Fera Commerce</label>
        </tab>
        <section id="fera_ai" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Fera.ai</label>
            <tab>fera_ai</tab>
            <resource>Fera_Ai::fera_config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="debug_mode" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Debug Mode</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="fera_ai_group" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>API Keys</label>
                <field id="public_key" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Public Key</label>
                </field>
                <field id="secret_key" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Secret Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>You can find your API keys at https://app.fera.ai/store/settings?tab=api</comment>
                </field>
                <field id="app_url" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>App URL</label>
                </field>
                <field id="api_url" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Api URL</label>
                </field>
                <field id="js_url" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Js URL</label>
                </field>
            </group>
            <group id="sync_settings" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Sync Settings</label>
                <field id="orders_export_on_creation" translate="label comment" type="select" sortOrder="10" showInDefault="1"
                    showInWebsite="1" showInStore="1">
                    <label>Export orders on creation</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, orders are exported to Fera.ai immediately after creation. When disabled, orders are only
                        exported when they are marked as complete.</comment>
                </field>
                <field id="minimize_data_sharing" translate="label comment" type="select" sortOrder="20" showInDefault="1" showInWebsite="1"
                    showInStore="1">
                    <label>Minimize data sharing</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When enabled, sensitive data like addresses, phone numbers, and monetary amounts are not sent to Fera.ai.
                        Orders will still include product names, quantities, and customer names/emails for review functionality.</comment>
                </field>
                <field id="fulfillment_export_delay_days" translate="label comment" type="text" sortOrder="30" showInDefault="1"
                    showInWebsite="1" showInStore="1">
                    <label>Fulfillment export delay (days)</label>
                    <validate>validate-zero-or-greater validate-digits</validate>
                    <comment>Number of days to wait after an order becomes Complete before sending fulfillment notification to Fera.ai. This
                        ensures customers receive their orders before being asked for reviews. Set to 0 for no delay.</comment>
                </field>
                <field id="brand" translate="label comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Brand</label>
                    <comment>Stable Google-facing brand value to include in product export for review matching.</comment>
                </field>
            </group>
            <group id="review_notifications" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1"
                showInStore="1">
                <label>Review Notifications</label>
                <field id="negative_review_notifications_enabled" translate="label comment" type="select" sortOrder="10"
                    showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Negative Review Notifications</label>
                    <comment>When enabled, reviews at or below the configured rating threshold can send negative-review notifications.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="review_update_notifications_enabled" translate="label comment" type="select" sortOrder="20"
                    showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Review Update Notifications</label>
                    <comment>When enabled, qualifying Fera review updates can send Slack notifications using the shared Slack Webhook URL below.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="rating_threshold" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1"
                    showInStore="1">
                    <label>Negative Review Rating Threshold</label>
                    <source_model>Fera\Ai\Model\Config\Source\Rating</source_model>
                </field>
                <field id="slack_webhook_url" translate="label" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="1"
                    showInStore="1">
                    <label>Slack Webhook URL</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="email_recipients" translate="label comment" type="textarea" sortOrder="50" showInDefault="1" showInWebsite="1"
                    showInStore="1">
                    <label>Negative Review Email Recipients</label>
                    <comment>Comma or newline separated email addresses for negative-review notifications.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
