<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/fera/webhook/review-created" method="POST">
        <service class="Fera\Ai\Api\ReviewCreatedWebhookInterface" method="execute" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/fera/webhook/review-updated" method="POST">
        <service class="Fera\Ai\Api\ReviewUpdatedWebhookInterface" method="execute" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
</routes>
