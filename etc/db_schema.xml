<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="fera_orders" resource="default" engine="innodb" comment="Fera Exported Orders">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="ID" />
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="Magento Order ID" />
        <column xsi:type="varchar" name="fera_id" nullable="false" length="64" comment="Fera Order ID" />
        <column xsi:type="timestamp" name="exported_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Exported At" />

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="FERA_ORDERS_ORDER_ID_UNQ">
            <column name="order_id" />
        </constraint>
        <index referenceId="FERA_ORDERS_FERA_ID_IDX">
            <column name="fera_id" />
        </index>
    </table>
    <table name="fera_products" resource="default" engine="innodb" comment="Fera Exported Products">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="ID" />
        <column xsi:type="int" name="product_id" padding="10" unsigned="true" nullable="false" comment="Magento Product ID" />
        <column xsi:type="varchar" name="fera_id" nullable="false" length="64" comment="Fera Product ID" />
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" identity="false" comment="Store ID" />
        <column xsi:type="timestamp" name="exported_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Exported At" />

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="FERA_PRODUCTS_PRODUCT_ID_STORE_ID_UNQ">
            <column name="product_id" />
            <column name="store_id" />
        </constraint>
        <constraint xsi:type="foreign" referenceId="FERA_PRODUCTS_STORE_ID_STORE_STORE_ID" table="fera_products"
            column="store_id" referenceTable="store" referenceColumn="store_id" onDelete="CASCADE" />
        <index referenceId="FERA_PRODUCTS_FERA_ID_IDX">
            <column name="fera_id" />
        </index>
    </table>
    <table name="fera_order_fulfillment" resource="default" engine="innodb" comment="Fera Order Fulfillment Queue">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="ID" />
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="Magento Order ID" />
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID" />
        <column xsi:type="timestamp" name="completed_at" nullable="true" comment="Order Completed At" />
        <column xsi:type="timestamp" name="exported_at" nullable="true" comment="Fulfillment Exported At" />
        <column xsi:type="timestamp" name="enqueued_at" nullable="true" comment="Fulfillment Enqueued At" />

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="FERA_ORDER_FULFILLMENT_ORDER_ID_UNQ">
            <column name="order_id" />
        </constraint>
        <constraint xsi:type="foreign" referenceId="FERA_ORDER_FULFILLMENT_ORDER_ID_SALES_ORDER_ENTITY_ID"
            table="fera_order_fulfillment" column="order_id" referenceTable="sales_order"
            referenceColumn="entity_id" onDelete="CASCADE" />
        <constraint xsi:type="foreign" referenceId="FERA_ORDER_FULFILLMENT_STORE_ID_STORE_STORE_ID"
            table="fera_order_fulfillment" column="store_id" referenceTable="store"
            referenceColumn="store_id" onDelete="CASCADE" />
        <index referenceId="FERA_ORDER_FULFILLMENT_EXPORTED_AT_IDX">
            <column name="exported_at" />
        </index>
        <index referenceId="FERA_ORDER_FULFILLMENT_STORE_ID_EXPORTED_AT_COMPLETED_AT_IDX">
            <column name="store_id" />
            <column name="exported_at" />
            <column name="completed_at" />
        </index>
        <index referenceId="FERA_ORDER_FULFILLMENT_ENQUEUED_AT_IDX">
            <column name="enqueued_at" />
        </index>
    </table>
    <table name="fera_review_snapshots" resource="default" engine="innodb" comment="Fera Review Snapshots">
        <column xsi:type="int" name="id" padding="10" unsigned="true" nullable="false" identity="true" comment="ID" />
        <column xsi:type="varchar" name="review_id" nullable="false" length="64" comment="Fera Review ID" />
        <column xsi:type="text" name="heading" nullable="false" comment="Review Heading" />
        <column xsi:type="text" name="body" nullable="false" comment="Review Body" />
        <column xsi:type="decimal" name="rating" scale="2" precision="4" unsigned="false" nullable="false" comment="Review Rating" />
        <column xsi:type="text" name="media" nullable="false" comment="Normalized Review Media" />
        <column xsi:type="smallint" name="magento_store_id" unsigned="true" nullable="true" default="NULL" comment="Canonical Magento Store ID" />
        <column xsi:type="varchar" name="subject" nullable="true" length="16" default="NULL" comment="Fera Review Subject" />
        <column xsi:type="varchar" name="external_product_id" nullable="true" length="255" default="NULL" comment="External Product ID" />
        <column xsi:type="varchar" name="fera_product_id" nullable="true" length="64" default="NULL" comment="Fera Product ID" />
        <column xsi:type="varchar" name="product_name" nullable="true" length="255" default="NULL" comment="Fera Product Name" />
        <column xsi:type="varchar" name="state" nullable="true" length="32" default="NULL" comment="Fera Review State" />
        <column xsi:type="boolean" name="is_test" nullable="true" default="NULL" comment="Fera Test Review Flag" />
        <column xsi:type="timestamp" name="fera_created_at" nullable="true" default="NULL" on_update="false" comment="Fera Review Created At" />
        <column xsi:type="timestamp" name="fera_updated_at" nullable="true" default="NULL" on_update="false" comment="Fera Review Updated At" />
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At" />
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At" />

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id" />
        </constraint>
        <constraint xsi:type="unique" referenceId="FERA_REVIEW_SNAPSHOTS_REVIEW_ID_UNQ">
            <column name="review_id" />
        </constraint>
        <index referenceId="FERA_REVIEW_SNAPSHOTS_STORE_SUBJECT_CREATED_AT_IDX">
            <column name="magento_store_id" />
            <column name="subject" />
            <column name="fera_created_at" />
        </index>
        <index referenceId="FERA_REVIEW_SNAPSHOTS_FERA_PRODUCT_ID_IDX">
            <column name="fera_product_id" />
        </index>
        <index referenceId="FERA_REVIEW_SNAPSHOTS_EXTERNAL_PRODUCT_ID_IDX">
            <column name="external_product_id" />
        </index>
    </table>
</schema>
