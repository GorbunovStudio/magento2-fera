<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="catalog_product_save_after">
        <observer name="fera_ai_product_push" instance="Fera\Ai\Observer\ProductPushEvent" />
    </event>

    <event name="sales_order_place_after">
        <observer name="fera_ai_order_push" instance="Fera\Ai\Observer\OrderPushEvent" />
    </event>

    <event name="sales_order_save_after">
        <observer name="fera_ai_order_push" instance="Fera\Ai\Observer\OrderPushEvent" />
    </event>

    <event name="customer_save_after">
        <observer name="fera_ai_customer_save" instance="Fera\Ai\Observer\CustomerEnqueueUpdateProcessing" />
    </event>
</config>