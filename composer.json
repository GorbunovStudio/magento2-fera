{
    "name": "feraai/fera",
    "type": "magento2-module",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Fera\\Ai\\": ""
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "magento/framework": "^103.0.0",
        "magento/module-sales": "^103.0.0",
        "magento/module-asynchronous-operations": "^100.4.0",
        "magento/module-catalog": "^104.0.0",
        "magento/module-catalog-inventory": "^100.4.0",
        "magento/module-checkout": "^100.4.0",
        "guzzlehttp/guzzle": "^7.00.0",
        "firebase/php-jwt": "^6.10",
        "magento/module-configurable-product": "^100.4.0",
        "magento/module-inventory-sales-api": "^1.2.0",
        "magento/module-inventory-configuration-api": "^1.2.0"
    },
    "repositories": {
        "0": {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    },
    "config": {
        "allow-plugins": {
            "magento/composer-dependency-version-audit-plugin": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.32.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "friendsofphp/php-cs-fixer": "^3.87",
        "magento/magento-coding-standard": "*",
        "phpmd/phpmd": "^2.15",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^1.12",
        "sebastian/phpcpd": "^6.0",
        "phpunit/phpunit": "^9.6"
    }
}
